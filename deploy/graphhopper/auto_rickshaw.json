{
  "speed": [
    {
      "if": "true",
      "limit_to": 30.0
    },
    {
      "if": "true",
      "limit_to": "max_speed"
    }
  ],
  "priority": [
    {
      "if": "!car_access",
      "multiply_by": "0"
    },
    {
      "if": "road_class == SECONDARY",
      "multiply_by": 0.9
    },
    {
      "if": "road_class == TERTIARY",
      "multiply_by": 0.8
    },
    {
      "if": "road_class == UNCLASSIFIED",
      "multiply_by": 0.7
    },
    {
      "if": "road_class == RESIDENTIAL",
      "multiply_by": 0.6
    },
    {
      "if": "road_class == LIVING_STREET",
      "multiply_by": 0.3
    },
    {
      "if": "road_class == SERVICE",
      "multiply_by": 0.3
    },
    {
      "if": "road_class == TRACK",
      "multiply_by": 0.1
    },
    {
      "if": "road_class == OTHER",
      "multiply_by": 0.3
    },
    {
      "if": "road_access == NO",
      "multiply_by": 0.0
    },
    {
      "if": "road_access == PRIVATE",
      "multiply_by": 0.0
    },
    {
      "if": "road_access == DELIVERY",
      "multiply_by": 0.0
    },
    {
      "if": "road_access == DESTINATION",
      "multiply_by": 0.1
    },
    {
      "if": "road_access == DISCOURAGED",
      "multiply_by": 0.5
    }
  ],
  "distance_influence": 0.0,
  "turn_penalty": [
    {
      "if": "change_angle >= 25 && change_angle < 150",
      "add": "8"
    },
    {
      "else_if": "-change_angle >= 25 && -change_angle < 150",
      "add": "2"
    }
  ]
}
